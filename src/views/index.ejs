<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/index.css">
    <title> <%= title %> </title>
  </head>
  <body>
    <a href="/new">Chat!</a>
    <ul class="message-list">
      <% for(let i = 0; i < messages.length; i++) { %>
        <li>
          <p id="user-name">User: <%= messages[i].username %></p>
          <p id="user-message">Text: <%= messages[i].message %></p>
          <p id="message-added">Added: <%= messages[i].dateadded.split(" ")[0] %></p>
          <div class="message-links">
            <a href="/message/<%= messages[i].id %>" id="more">more</a> 
            <a href="/delete/<%= messages[i].id %>" id="delete-message">delete</a>
          </div>
          <% } %>
        </li>
    </ul>

  </body>
</html>   
