<html>
  <body>
    <ul>
      <% for(let i = 0; i < messages.length; i++) { %>
      <p>Text: <%= messages[i].message %></p>
      <p>User: <%= messages[i].username %></p>
      <p>Added: <%= messages[i].dateadded %></p>
      <a href="/message/<%= messages[i].id %>">more</a>
      <% } %>
    </ul>
  
    <a href="/new">Chat!</a>
  </body>
</html>   
